#!/bin/bash
# 目的: RoBaのMACアドレスを動的に取得し、接続を確立する

echo "🔍 Searching for RoBa..."

# 1. Bluetoothコントローラーを確実にON
bluetoothctl power on > /dev/null 2>&1

# 2. MACアドレスの取得
# ペアリング済みリストから "roBa" を検索
MAC_ADDR=$(bluetoothctl devices | grep -i "roBa" | awk '{print $2}' | head -n 1)

# ペアリングされていない、または見つからない場合
if [ -z "$MAC_ADDR" ]; then
    echo "⚠️  RoBa not found in paired devices."
    echo "📡 Scanning for new devices..."

    # スキャンを開始してバックグラウンドで実行
    bluetoothctl scan on &
    SCAN_PID=$!
    sleep 8

    # スキャン結果から取得（devices Pairedではなくdevicesで全て）
    MAC_ADDR=$(bluetoothctl devices | grep -i "roBa" | awk '{print $2}' | head -n 1)

    # スキャン停止
    kill $SCAN_PID 2>/dev/null
    bluetoothctl scan off > /dev/null 2>&1
fi

if [ -z "$MAC_ADDR" ]; then
    echo "❌ RoBa device could not be found. Please ensure it is powered on and in range."
    echo "Press Enter to exit..."
    read
    exit 1
fi

# デバイスが見つかったら、ペアリング状態を確認
PAIRED=$(bluetoothctl info "$MAC_ADDR" 2>/dev/null | grep "Paired: yes")

if [ -z "$PAIRED" ]; then
    echo "🔗 Device found but not paired. Pairing now..."
    bluetoothctl pair "$MAC_ADDR"
    sleep 1
    bluetoothctl trust "$MAC_ADDR"
    sleep 1
fi

echo "🎯 Target Found: $MAC_ADDR"
echo "🔄 Connecting..."

# 3. 接続ループ (繋がるまで粘る)
RETRY_COUNT=0
while true; do
    # 接続を試行
    if bluetoothctl connect "$MAC_ADDR"; then
        echo ""
        echo "✅ Connection Successful!"
        echo "   Closing in 3 seconds..."
        sleep 3
        break
    else
        RETRY_COUNT=$((RETRY_COUNT + 1))
        echo "⚠️  Connection failed (attempt $RETRY_COUNT)."

        # 1回失敗したらデバイスを削除して再ペアリング
        echo "🔄 Removing device for re-pairing..."
        bluetoothctl remove "$MAC_ADDR"
        sleep 1

        echo "📡 Scanning for device..."
        bluetoothctl --timeout 5 scan on > /dev/null 2>&1

        MAC_ADDR=$(bluetoothctl devices | grep "roBa" | awk '{print $2}' | head -n 1)

        if [ -z "$MAC_ADDR" ]; then
            echo "❌ Device not found. Please ensure RoBa is powered on."
            echo "Press Enter to exit..."
            read
            exit 1
        fi

        echo "🎯 Device found: $MAC_ADDR"
        echo "🔗 Pairing..."
        bluetoothctl pair "$MAC_ADDR"
        sleep 1
        bluetoothctl trust "$MAC_ADDR"
        sleep 1

        echo "   Retrying connection in 2 seconds... (Press Ctrl+C to stop)"
        sleep 2
    fi
done
